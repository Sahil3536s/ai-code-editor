# CodeAnywhere — Backend Environment Variables
# Copy this file to .env and fill in your values.
# All values shown here are the secure production defaults.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3001

# ── Execution timing / sizing ─────────────────────────────────────────────────
# Maximum time (ms) a container is allowed to run before being force-killed
EXECUTION_TIMEOUT_MS=10000

# Maximum bytes captured from stdout + stderr (64 KB)
MAX_OUTPUT_BYTES=65536

# Maximum simultaneous Docker containers; excess requests queue (not rejected)
MAX_CONCURRENT=5

# Maximum source code size per request (100 KB)
MAX_CODE_BYTES=102400

# ── Container resource limits ─────────────────────────────────────────────────
# Memory hard cap per container (Docker format: 128m, 256m, 1g …)
MEMORY_LIMIT=128m

# CPU share per container (fractional cores: 0.5 = half a core)
CPU_LIMIT=0.5

# Maximum number of processes/threads inside the container.
# Protects against fork bombs. 64 is enough for JVM threads while blocking
# exponential fork attacks (which need 2^N processes to be effective).
PIDS_LIMIT=64

# Maximum open file descriptors per container (soft and hard limit).
# Prevents file descriptor exhaustion attacks.
MAX_OPEN_FILES=512

# Size in MB of the /tmp tmpfs writeable scratch space inside containers.
# Compilers (gcc, javac, rustc) write binaries and class files here.
TMPFS_SIZE_MB=32

# ── Container identity (non-root user) ───────────────────────────────────────
# UID and GID used for --user in docker run.
# 65534 is the standard "nobody" UID/GID on most Linux distributions.
# All code runs with no privileges — even if a vulnerability is exploited,
# the attacker controls only a nobody process with no capabilities.
CONTAINER_UID=65534
CONTAINER_GID=65534

# ── HTTP rate limiting ────────────────────────────────────────────────────────
# Max POST /api/execute requests per IP per minute.
# Code execution is expensive; keep this low.
RATE_LIMIT_EXECUTE=15

# Max requests to any other endpoint per IP per minute.
RATE_LIMIT_GENERAL=60
